  {
    "name": "bili_upload_video",
    "description": "\n    上传视频到B站\n\n    Args:\n        video_path: 视频文件的本地路径\n        title: 视频标题（最多80字）\n        desc: 视频简介描述\n        tid: 分区ID，默认124（趣味科普人文-社科·法律·心理）。\n             常用分区：17=单机游戏 21=日常 95=数码 122=野生技术协会\n             124=社科 160=生活记录 171=电子竞技 183=影视杂谈\n             188=科技资讯 201=科学 207=财经商业 208=科技 209=手工\n             230=其他(生活) 231=美食 234=健身 32=完结动画\n        tags: 标签，逗号分隔，如\"AI,教程,编程\"（至少1个标签）\n        cover_path: 封面图片路径（可选，不填则B站自动截取）\n        source: 转载来源URL（非原创时必填）\n        dynamic_text: 粉丝动态文本（可选，投稿时同步发布的动态内容）\n        no_reprint: 是否启用未经作者授权禁止转载，默认True\n\n    Returns:\n        上传结果，包含BV号\n    ",
    "inputSchema": {
      "properties": {
        "video_path": {
          "title": "Video Path",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "desc": {
          "default": "",
          "title": "Desc",
          "type": "string"
        },
        "tid": {
          "default": 124,
          "title": "Tid",
          "type": "integer"
        },
        "tags": {
          "default": "AI",
          "title": "Tags",
          "type": "string"
        },
        "cover_path": {
          "default": "",
          "title": "Cover Path",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "dynamic_text": {
          "default": "",
          "title": "Dynamic Text",
          "type": "string"
        },
        "no_reprint": {
          "default": true,
          "title": "No Reprint",
          "type": "boolean"
        }
      },
      "required": [
        "video_path",
        "title"
      ],
      "title": "bili_upload_videoArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "bili_upload_videoOutput",
      "type": "object"
    }
  },
